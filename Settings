Branch: main
Folder: /root
body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: linear-gradient(135deg, #000000, #1a1a1a);
    color: gold;
}

header {
    background: #111;
    padding: 20px;
    text-align: center;
    border-bottom: 2px solid gold;
    box-shadow: 0 4px 10px rgba(255, 215, 0, 0.3);
}

nav a {
    color: gold;
    margin: 0 15px;
    text-decoration: none;
    font-weight: bold;
    transition: 0.3s;
}

nav a:hover {
    color: #fff;
    text-shadow: 0 0 8px gold;
}

section {
    padding: 50px;
    text-align: center;
}

button {
    background: gold;
    color: black;
    border: none;
    padding: 15px 30px;
    font-size: 18px;
    cursor: pointer;
    border-radius: 8px;
    transition: all 0.3s;
    box-shadow: 0 4px 8px rgba(255, 215, 0, 0.4);
}

button:hover {
    background: #ffd700;
    transform: scale(1.1);
    box-shadow: 0 6px 12px rgba(255, 215, 0, 0.6);
}

.card, .service {
    background: #222;
    padding: 20px;
    margin: 20px auto;
    width: 90%;
    max-width: 500px;
    border: 1px solid gold;
    border-radius: 12px;
    transition: 0.3s;
}

.card:hover, .service:hover {
    background: #333;
    box-shadow: 0 4px 15px rgba(255, 215, 0, 0.5);
}
